{
  "name": "Sighting",
  "type": "object",
  "properties": {
    "species": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "photo_url": {
      "type": "string"
    },
    "reported_by": {
      "type": "string"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time the sighting was recorded"
    }
  },
  "required": [
    "species",
    "lat",
    "lng"
  ]
}
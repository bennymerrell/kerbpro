{
  "name": "Sighting",
  "type": "object",
  "properties": {
    "species": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "photo_url": {
      "type": "string"
    },
    "reported_by": {
      "type": "string"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time the sighting was recorded"
    },
    "status_details": {
      "type": "string",
      "description": "Category-specific status, e.g. 'working' or 'not_working' for Hydrants"
    }
  },
  "required": [
    "species",
    "lat",
    "lng"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}
{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "manager",
        "user"
      ],
      "default": "user"
    },
    "office_id": {
      "type": "string",
      "description": "ID of the Office this user belongs to"
    },
    "manager_id": {
      "type": "string",
      "description": "ID of the manager user assigned to this user"
    },
    "phone": {
      "type": "string",
      "description": "Mobile phone number for SMS/WhatsApp notifications"
    },
    "active_cell_id": {
      "type": "string",
      "description": "ID of the cell the user is currently checked into"
    },
    "active_cell_prev_status": {
      "type": "string",
      "description": "Previous work status of the cell before check-in"
    },
    "active_cell_checkin_date": {
      "type": "string",
      "description": "Date the user checked into the active cell"
    },
    "manager_logout_message": {
      "type": "string",
      "description": "Set by backend when a manager logs a user out of a cell \u2014 triggers in-app notification modal"
    }
  }
}
{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "manager",
        "user"
      ],
      "default": "user"
    },
    "office_id": {
      "type": "string",
      "description": "ID of the Office this user (manager) belongs to"
    },
    "manager_id": {
      "type": "string",
      "description": "ID of the Manager (User) this user is assigned to"
    }
  }
}
{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "manager",
        "admin"
      ],
      "default": "user"
    },
    "office_id": {
      "type": "string",
      "description": "ID of the Office this user is assigned to"
    },
    "active_cell_id": {
      "type": "string",
      "description": "ID of the cell the user is currently logged into"
    },
    "active_cell_prev_status": {
      "type": "string",
      "description": "Previous status of the cell before user logged in"
    },
    "active_cell_checkin_date": {
      "type": "string",
      "format": "date",
      "description": "Date the user checked into the current cell"
    },
    "phone": {
      "type": "string",
      "description": "Mobile phone number for notifications (e.g. +447700900000)"
    },
    "manager_id": {
      "type": "string",
      "description": "ID of the user's assigned manager"
    },
    "manager_logout_message": {
      "type": "string",
      "description": "Message set by manager when logging out the user"
    },
    "communications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the user receives email/SMS notifications"
    }
  },
  "required": []
}
{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "manager"
      ],
      "default": "user"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last app activity"
    }
  },
  "required": []
}
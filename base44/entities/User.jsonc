{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "manager",
        "admin"
      ],
      "default": "user"
    },
    "office_id": {
      "type": "string",
      "description": "ID of the Office this user belongs to"
    },
    "manager_id": {
      "type": "string",
      "description": "ID of the User who is this user's manager"
    },
    "phone": {
      "type": "string",
      "description": "Mobile phone number for SMS/WhatsApp notifications (e.g. +447700900000)"
    },
    "active_cell_id": {
      "type": "string",
      "description": "ID of the cell the user is currently checked into"
    },
    "active_cell_prev_status": {
      "type": "string",
      "description": "Previous work_status of the cell before check-in"
    },
    "active_cell_checkin_date": {
      "type": "string",
      "description": "Date the user checked into the active cell (YYYY-MM-DD)"
    }
  }
}
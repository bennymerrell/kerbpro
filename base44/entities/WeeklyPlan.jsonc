{
  "name": "WeeklyPlan",
  "type": "object",
  "properties": {
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "Monday of the planned week (YYYY-MM-DD)"
    },
    "assignments": {
      "type": "string",
      "description": "JSON array of { user_id, user_name, cell_id, cell_name, cell_area, day } where day is 0=Mon..4=Fri"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "week_start"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}
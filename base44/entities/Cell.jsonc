{
  "name": "Cell",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "points": {
      "type": "string"
    },
    "visible": {
      "type": "boolean"
    },
    "area": {
      "type": "string"
    },
    "adopted_m": {
      "type": "number"
    },
    "unadopted_m": {
      "type": "number"
    },
    "road_breakdown": {
      "type": "string",
      "description": "JSON object of {highway_type: meters}"
    },
    "excluded_road_types": {
      "type": "string",
      "description": "JSON array of excluded highway types"
    },
    "recalc_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "done",
        "error"
      ],
      "description": "Status of background mileage recalculation"
    },
    "recalc_error": {
      "type": "string",
      "description": "Error message if recalc failed"
    }
  },
  "required": [
    "points"
  ]
}
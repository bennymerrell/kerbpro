{
  "name": "Cell",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "points": {
      "type": "string"
    },
    "visible": {
      "type": "boolean"
    },
    "area": {
      "type": "string"
    },
    "adopted_m": {
      "type": "number"
    },
    "unadopted_m": {
      "type": "number"
    },
    "road_breakdown": {
      "type": "string",
      "description": "JSON object of {highway_type: meters}"
    },
    "excluded_road_types": {
      "type": "string",
      "description": "JSON array of excluded highway types"
    },
    "recalc_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "done",
        "error"
      ],
      "description": "Status of background mileage recalculation"
    },
    "recalc_error": {
      "type": "string",
      "description": "Error message if recalc failed"
    },
    "os_validated_m": {
      "type": "number",
      "description": "Total road metres from OS Features API validation"
    },
    "os_validated_status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "error"
      ],
      "description": "Result of OS mileage validation"
    },
    "os_validated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last OS validation"
    },
    "work_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started",
      "description": "Current work status of this cell"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when cell was last marked as completed"
    },
    "completed_by": {
      "type": "string",
      "description": "Email of user who last marked as completed"
    },
    "office_id": {
      "type": "string",
      "description": "ID of the Office this cell belongs to"
    },
    "assigned_user_ids": {
      "type": "string",
      "description": "JSON array of user IDs pre-assigned to this cell (does not auto-start them)"
    }
  },
  "required": [
    "points"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "data.office_id": "{{user.data.office_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "$or": [
                {
                  "created_by": "{{user.email}}"
                },
                {
                  "data.assigned_user_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
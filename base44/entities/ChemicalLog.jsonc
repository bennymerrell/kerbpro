{
  "name": "ChemicalLog",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "chemicals": {
      "type": "string",
      "description": "JSON array of {chemical_name, unit, start_amount, end_amount}"
    },

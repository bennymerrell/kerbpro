{
  "name": "ChemicalLog",
  "type": "object",
  "properties": {
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "Date log was opened (Monday)"
    },
    "week_end": {
      "type": "string",
      "format": "date",
      "description": "Date log was completed (Friday)"
    },
    "chemicals": {
      "type": "string",
      "description": "JSON array of {chemical_name, unit, start_amount, end_amount}"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "week_start",
    "chemicals"
  ]
}
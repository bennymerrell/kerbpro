{
  "name": "SprayLog",
  "type": "object",
  "properties": {
    "cell_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "quantity_liters": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "cell_id",
    "date"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}
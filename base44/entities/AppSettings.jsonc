{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "default_lat": {
      "type": "number"
    },
    "default_lng": {
      "type": "number"
    },
    "default_zoom": {
      "type": "number"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "user"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}